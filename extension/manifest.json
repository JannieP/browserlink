{
  "manifest_version": 3,
  "name": "BrowserLink",
  "version": "0.1.0",
  "description": "Lets local agents (Claude Code) read and drive this browser profile through the BrowserLink hub on 127.0.0.1.",
  "key": "",
  "minimum_chrome_version": "135",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "debugger", "storage", "alarms", "userScripts", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "BrowserLink", "default_popup": "options.html" }
}
